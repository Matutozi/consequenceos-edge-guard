VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Required in every environment, including localhost. In development the app also
# enables the App Check debug token; register it in the Firebase console.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=


# Chrome extension only (npm run build:extension). reCAPTCHA cannot run in an extension, so
# its cloud path uses an App Check debug token: create one in the Firebase console under
# App Check > Apps > Manage debug tokens. It ends up inside the built extension, so share
# builds only with judges and revoke the token afterwards. Leave empty for on-device only.
VITE_EXTENSION_APPCHECK_DEBUG_TOKEN=
